# ─────────────────────────────────────────────────────────────────────────────
# Dashboard Financeiro Unificado — variaveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env — ele ja esta no .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados (destino — banco unificado) ────────────────────────────────
# Use a connection string do Supabase Pooler (Transaction Mode):
#   postgresql://usuario:senha@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Ou PostgreSQL local:
#   postgresql://postgres:senha@localhost:5432/finapp_dev
DATABASE_URL=""
SUPABASE_DB_URL=""

# ── Usuario proprietario dos dados ────────────────────────────────────────────
# UUID do usuario na tabela `usuarios` do banco unificado.
# Todas as queries filtram por este ID (single-user app).
# Obter apos criar o usuario: SELECT id FROM usuarios LIMIT 1;
OWNER_USER_ID=""

# ── Autenticacao do app (Streamlit Cloud) ─────────────────────────────────────
# Protege o app quando publicado. Vazio = sem senha (dev local).
# Pode ser texto simples OU hash SHA-256 (mais seguro):
#   python -c "import hashlib; print(hashlib.sha256(b'suasenha').hexdigest())"
APP_PASSWORD=""

# ── Inteligencia artificial (Fase 8) ──────────────────────────────────────────
OPENAI_API_KEY=""
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_S="45"
AI_MAX_RETRIES="2"

# ── Ambiente ──────────────────────────────────────────────────────────────────
APP_ENV="development"
# MOCK_MODE=true  → dados mockados (Fases 1-3)
# MOCK_MODE=false → dados reais do banco (Fase 4+, requer DATABASE_URL)
MOCK_MODE="true"

# ── Fontes de importacao — bancos dos apps originais (somente leitura) ────────
# Conectados apenas durante importacao de dados historicos.
# Nunca usados para gravacao no banco destino.
# Tiago84Barros/Dashboard
SOURCE_DB_APP1=""
# Tiago84Barros/Dashboard-Investimentos
SOURCE_DB_APP2=""
# Tiago84Barros/Controle_Financeiro
SOURCE_DB_APP3=""
