# ─────────────────────────────────────────────────────────────────────────────
# Dashboard Financeiro Unificado — variaveis de ambiente
#
# Dev local  : copie para .env e preencha os valores.
#              NUNCA commite o .env — ele ja esta no .gitignore.
#
# Streamlit Cloud: NAO use .env em producao.
#              Configure as mesmas variaveis em:
#              App > Settings > Secrets  (formato TOML, ex.: CHAVE = "valor")
#              O app le st.secrets primeiro, depois os.environ (.env).
#
# Estrategia de banco (Fase 4.0):
#   Banco unificado → projeto Supabase existente do Dashboard Financeiro.
#   Usar SUPABASE_UNIFICADO_URL como variavel principal.
#   DATABASE_URL mantida para retrocompatibilidade.
#   NAO criar terceiro projeto Supabase (plano gratuito = max 2 projetos).
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco unificado (Dashboard Financeiro — banco central do App 4) ───────────
# Connection string do Supabase Pooler (Transaction Mode, porta 6543).
# Projeto: Dashboard Financeiro (existente — nao criar novo projeto).
# Formato: postgresql://app4_reader:SENHA@HOST.pooler.supabase.com:6543/postgres
SUPABASE_UNIFICADO_URL=""

# Chave anon (publica) do projeto Dashboard Financeiro.
# Usada opcionalmente para chamadas REST ao Supabase.
# Nao usar service_role_key aqui — apenas localmente para migracao.
SUPABASE_UNIFICADO_ANON_KEY=""

# ── Banco de origem (Controle Financeiro — leitura para migracao) ─────────────
# Connection string do pooler Supabase do projeto Controle Financeiro.
# Usado apenas para leitura durante a migracao de dados historicos (Fase 4.7).
# Nunca usado para gravacao no banco destino.
SUPABASE_ORIGEM_CONTROLE_URL=""

# Chave anon do projeto Controle Financeiro (opcional — para listagem REST).
SUPABASE_ORIGEM_CONTROLE_ANON_KEY=""

# ── Retrocompatibilidade — variaveis legadas ──────────────────────────────────
# Mantidas para nao quebrar configuracoes existentes.
# Preferir SUPABASE_UNIFICADO_URL. db_url usa: SUPABASE_UNIFICADO_URL > DATABASE_URL > SUPABASE_DB_URL
DATABASE_URL=""
SUPABASE_DB_URL=""

# ── Usuario proprietario dos dados ────────────────────────────────────────────
# UUID do usuario na tabela `usuarios` do banco unificado.
# Todas as queries filtram por este ID (single-user app).
# Obter apos aplicar o schema: SELECT id FROM usuarios LIMIT 1;
OWNER_USER_ID=""

# ── Autenticacao do app (Streamlit Cloud) ─────────────────────────────────────
# Protege o app quando publicado. Vazio = sem senha (dev local).
# Pode ser texto simples OU hash SHA-256 (mais seguro):
#   python -c "import hashlib; print(hashlib.sha256(b'suasenha').hexdigest())"
APP_PASSWORD=""

# ── Inteligencia artificial (Fase 8) ──────────────────────────────────────────
OPENAI_API_KEY=""
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_S="45"
AI_MAX_RETRIES="2"

# Gemini — provedor de FALLBACK. Se a OpenAI falhar (ex.: cota 429), a analise
# LLM e o chat usam o Gemini automaticamente. Pode configurar so um dos dois ou
# ambos (recomendado p/ alta disponibilidade). Aceita GEMINI_API_KEY ou GOOGLE_API_KEY.
# Chave: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Endpoint compativel com a API da OpenAI (nao precisa alterar):
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# ── Empresas Americanas — fontes de dados ─────────────────────────────────────
# FONTE PADRAO: SEC EDGAR (fundamentos, dominio publico, gratuito) + yfinance
# (precos). Usadas SO PELA INGESTAO (run_us_ingest.py / data_pipeline/us).
# A interface le apenas o warehouse local e funciona OFFLINE apos a carga.
#
# A SEC EXIGE identificacao no User-Agent (senao responde 403). NAO e segredo,
# mas e obrigatorio. Formato: "Seu Nome seu@email.com"
SEC_USER_AGENT=""

# Fonte de fundamentos: edgar (padrao) | fmp
US_FUNDAMENTALS_SOURCE="edgar"

# FMP: OPCIONAL e desativada por padrao. Os Termos da FMP proibem copia/
# armazenamento sem autorizacao escrita e exigem apagar tudo (inclusive cache)
# ao encerrar a assinatura — incompativel com o warehouse local. So use com
# licenca compativel. NUNCA commitar a chave real.
FMP_API_KEY=""
FMP_BASE_URL="https://financialmodelingprep.com/api"

# ── Ambiente ──────────────────────────────────────────────────────────────────
APP_ENV="development"
# MOCK_MODE=true  → dados mockados (padrao — Fases 1 a 4.8)
# MOCK_MODE=false → dados reais do banco (Fase 4.9+, requer SUPABASE_UNIFICADO_URL)
MOCK_MODE="true"

# ── Fontes de importacao — bancos dos apps originais (somente leitura) ────────
# Conectados apenas durante importacao de dados historicos (Fases 4.6/4.7).
# Nunca usados para gravacao no banco unificado.

# Tiago84Barros/Dashboard — PostgreSQL/Supabase
SOURCE_DB_APP1=""

# Tiago84Barros/Dashboard-Investimentos — SQLite local
# Formato: sqlite:///C:/caminho/absoluto/para/investment_dashboard.db
# Ou relativo (a partir da raiz do Dashboard-Investimentos):
#   sqlite:///./investment_dashboard.db
SOURCE_DB_APP2=""

# Tiago84Barros/Controle_Financeiro — alias legado de SUPABASE_ORIGEM_CONTROLE_URL
# Preferir SUPABASE_ORIGEM_CONTROLE_URL. Mantido para retrocompatibilidade.
SOURCE_DB_APP3=""

# ── service_role_key (SOMENTE LOCAL — jamais em producao ou commits) ──────────
# Necessaria apenas para operacoes de admin durante migracao (Fases 4.5/4.7).
# NUNCA commitar este valor. NUNCA usar no Streamlit Cloud.
# NUNCA expor no frontend. Descomente apenas quando necessario localmente.
# SUPABASE_UNIFICADO_SERVICE_ROLE_KEY=""
